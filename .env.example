# Kaan runs completely without this file.
# Copy to .env only if you want the optional upgrades below.
# Without it, the app uses the local matcher, recognises the bundled demo
# audio, and says so in the UI.

# --- Optional: better claim extraction (text) -------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Optional: transcribe uploaded audio that is not a bundled note ---------
# Any OpenAI-compatible Whisper endpoint works. Either key enables it.
# Groq's free tier is the cheapest way to try the upload path with real audio.
OPENAI_TRANSCRIBE_MODEL=whisper-1
GROQ_API_KEY=
GROQ_TRANSCRIBE_MODEL=whisper-large-v3
